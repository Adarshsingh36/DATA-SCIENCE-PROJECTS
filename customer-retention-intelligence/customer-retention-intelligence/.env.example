# Copy to .env and fill in. NEVER commit .env.
POSTGRES_USER=retention_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer_retention_db
# Optional: single URL instead of the variables above
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/customer_retention_db
# Development-only explicit fallback if PostgreSQL is unreachable (logs a loud warning):
# ALLOW_SQLITE_FALLBACK=true
# Business assumptions (defaults shown)
# CONTRIBUTION_MARGIN=0.40
# ANNUAL_DISCOUNT_RATE=0.10
# CLV_HORIZON_MONTHS=36
